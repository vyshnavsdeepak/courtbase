{
  "name": "@court-base/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./models": {
      "types": "./dist/models.d.ts",
      "default": "./src/models.ts"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "default": "./src/constants.ts"
    },
    "./schemas/*": {
      "types": "./dist/schemas/*.d.ts",
      "default": "./src/schemas/*.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "lint-staged": "lint-staged"
  },
  "lint-staged": {
    "*.{ts}": [
      "eslint --fix",
      "prettier --check --ignore-path ../../.gitignore --write"
    ]
  },
  "dependencies": {
    "@court-base/auth": "workspace:*",
    "@court-base/db": "workspace:*",
    "@court-base/validators": "workspace:*",
    "@court-base/event-funnel": "workspace:*",
    "@trpc/server": "catalog:",
    "superjson": "2.2.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@court-base/eslint-config": "workspace:*",
    "@court-base/prettier-config": "workspace:*",
    "@court-base/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@court-base/prettier-config"
}
