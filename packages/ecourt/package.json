{
  "name": "@court-base/ecourt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    "./*": "./src/api/*.ts"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf .turbo node_modules",
    "dev": "tsc --watch",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "lint-staged": "lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --check --ignore-path ../../.gitignore --write"
    ]
  },
  "devDependencies": {
    "@court-base/eslint-config": "workspace:*",
    "@court-base/prettier-config": "workspace:*",
    "@court-base/tsconfig": "workspace:*",
    "@types/crypto-js": "^4.2.2",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@court-base/prettier-config",
  "dependencies": {
    "axios": "^1.7.4",
    "cheerio": "^1.0.0",
    "crypto-js": "^4.2.0",
    "date-fns": "^3.6.0"
  }
}
