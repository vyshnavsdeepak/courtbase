{
  "name": "@court-base/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./models": {
      "types": "./dist/src/models/index.d.ts",
      "default": "./dist/src/models/index.js"
    },
    "./types": {
      "types": "./dist/kysely/types.d.ts",
      "default": "./dist/kysely/types.js"
    },
    "./enums": {
      "types": "./dist/kysely/enums.d.ts",
      "default": "./dist/kysely/enums.js"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc && cp -r prisma dist/",
    "dev": "cp -r prisma dist/ && tsc --watch",
    "clean": "rm -rf .prisma .turbo dist node_modules",
    "runscript": "dotenv -e ../../.env -- tsx",
    "db:format": "if [ \"$NODE_ENV\" != \"production\" ]; then prisma format; fi",
    "db:generate:raw": "pnpm with-env prisma generate",
    "db:migrate:raw": "pnpm with-env prisma migrate dev",
    "db:generate": "pnpm db:format && pnpm db:generate:raw && pnpm format --write",
    "db:migrate": "pnpm db:format && pnpm db:migrate:raw && pnpm format --write",
    "db:migrate:deploy": "pnpm with-env prisma migrate deploy",
    "push": "pnpm with-env prisma db push --skip-generate",
    "pull": "pnpm with-env prisma db pull",
    "studio": "pnpm with-env prisma studio --port 5556",
    "format": "prettier --check src/models",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "with-env": "dotenv -e ../../.env --",
    "lint-staged": "lint-staged"
  },
  "lint-staged": {
    "*.{ts}": [
      "eslint --fix",
      "pnpm run format --write"
    ]
  },
  "dependencies": {
    "@prisma/client": "5.18.0",
    "@t3-oss/env-core": "^0.10.1",
    "@vercel/postgres": "^0.9.0",
    "kysely": "^0.27.4",
    "kysely-neon": "^1.3.0",
    "pg": "^8.12.0",
    "prisma-kysely": "^1.8.0",
    "tsx": "^4.17.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@court-base/eslint-config": "workspace:*",
    "@court-base/prettier-config": "workspace:*",
    "@court-base/tsconfig": "workspace:*",
    "dotenv-cli": "^7.4.2",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "prisma": "^5.18.0",
    "typescript": "catalog:",
    "zod-prisma-types": "^3.1.8"
  },
  "prettier": "@court-base/prettier-config"
}
