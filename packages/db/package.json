{
  "name": "@court-base/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./models": {
      "types": "./dist/src/models/index.d.ts",
      "default": "./dist/src/models/index.js"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "dev": "tsc",
    "clean": "rm -rf .turbo dist node_modules",
    "runscript": "dotenv -e ../../.env -- tsx",
    "db:generate": "pnpm with-env prisma generate && eslint --fix src/models && prettier --check --ignore-path ../../.gitignore --write src/models",
    "db:migrate": "pnpm with-env prisma migrate dev && eslint --fix src/models && prettier --check --ignore-path ../../.gitignore --write src/models",
    "push": "pnpm with-env prisma db push --skip-generate",
    "pull": "pnpm with-env prisma db pull",
    "studio": "pnpm with-env prisma studio --port 5556",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "with-env": "dotenv -e ../../.env --",
    "lint-staged": "lint-staged"
  },
  "lint-staged": {
    "*.{ts}": [
      "eslint --fix",
      "prettier --check --ignore-path ../../.gitignore --write"
    ]
  },
  "dependencies": {
    "@prisma/client": "5.17.0",
    "@t3-oss/env-core": "^0.10.1",
    "@vercel/postgres": "^0.9.0",
    "kysely": "^0.27.4",
    "kysely-neon": "^1.3.0",
    "pg": "^8.12.0",
    "prisma-kysely": "^1.8.0",
    "tsx": "^4.16.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@court-base/eslint-config": "workspace:*",
    "@court-base/prettier-config": "workspace:*",
    "@court-base/tsconfig": "workspace:*",
    "dotenv-cli": "^7.4.2",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "prisma": "^5.17.0",
    "typescript": "catalog:",
    "zod-prisma": "^0.5.4"
  },
  "prettier": "@court-base/prettier-config"
}
