generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator kysely {
  provider     = "prisma-kysely"
  output       = "../kysely"
  fileName     = "types.ts"
  enumFileName = "enums.ts"
}

generator zod {
  provider                         = "zod-prisma-types"
  output                           = "../src/models" // default is ./generated/zod
  useMultipleFiles                 = false // default is false
  writeBarrelFiles                 = false // default is true
  createInputTypes                 = false // default is true
  createModelTypes                 = true // default is true
  addInputTypeValidation           = false // default is true
  addIncludeType                   = false // default is true
  addSelectType                    = false // default is true
  validateWhereUniqueInput         = true // default is true
  createOptionalDefaultValuesTypes = false // default is false
  createRelationValuesTypes        = true // default is false
  createPartialTypes               = false // default is false
  useDefaultValidators             = false // default is true
  coerceDate                       = true // default is true
  writeNullishInModelTypes         = true // default is false
}

model Account {
  userId            String  @db.Uuid
  type              String  @db.VarChar(255)
  provider          String  @db.VarChar(255)
  providerAccountId String  @db.VarChar(255)
  refresh_token     String? @db.VarChar(255)
  access_token      String?
  expires_at        Int?
  token_type        String? @db.VarChar(255)
  scope             String? @db.VarChar(255)
  id_token          String?
  session_state     String? @db.VarChar(255)
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "account_userId_user_id_fk")

  @@id([provider, providerAccountId], map: "account_provider_providerAccountId_pk")
}

model Post {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title      String    @db.VarChar(256)
  content    String
  created_at DateTime  @default(now()) @db.Timestamp(6)
  updatedAt  DateTime? @db.Timestamptz(6)
}

model Session {
  sessionToken String   @id @db.VarChar(255)
  userId       String   @db.Uuid
  expires      DateTime @db.Timestamptz(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "session_userId_user_id_fk")
}

model User {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String?          @db.VarChar(255)
  email          String           @db.VarChar(255)
  emailVerified  DateTime?        @db.Timestamptz(6)
  image          String?          @db.VarChar(255)
  account        Account[]
  session        Session[]
  CaseImportTask CaseImportTask[]
}

model VerificationToken {
  token      String   @id @db.VarChar(255)
  identifier String   @db.VarChar(255)
  expires    DateTime @db.Timestamptz(6)

  @@unique([identifier, token], map: "verificationToken_identifier_token_unique")
}

model Organization {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String           @db.VarChar(255)
  slug           String           @unique
  cases          Case[]           @relation(map: "case_organization_organization_id_fk")
  CaseImportTask CaseImportTask[]
}

enum OrgDesignation {
  ADVOCATE
  STAFF
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

model OrganizationMembers {
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  role           OrgRole          @default(MEMBER)
  designation    OrgDesignation?
  AdvocateCase   AdvocateCase[]   @relation(map: "advocateCase_advocateId_organizationId_fk")
  CaseImportTask CaseImportTask[] @relation(map: "caseImportTask_advocateId_organizationMembers_userId_fk")

  @@id([organizationId, userId], map: "organizationMembers_organizationId_userId_pk")
}

enum AdvocateCaseSide {
  PETITIONER
  RESPONDENT
  UNKNOWN
}

model Case {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  crn               String    @db.VarChar(16)
  courtId           String    @db.Uuid
  typeName          String    @db.VarChar(50) // eg. OP, OS, CC, MC
  number            String    @db.VarChar(4) // eg. 232
  regYear           String    @db.VarChar(4) // eg. 2021
  // typeName/number/regYear is unique in a court = eg. OP/232/2021
  title             String    @db.VarChar(255)
  description       String?   @db.VarChar(255)
  petitioner        String    @db.VarChar(255)
  petitionerLawyers String    @db.VarChar(255)
  respondent        String    @db.VarChar(255)
  respondentLawyers String    @db.VarChar(255)
  dateOfDecision    DateTime? @db.Date
  nextHearingDate   DateTime? @db.Date

  // side - petitioner/respondent
  side             AdvocateCaseSide
  extraPetitioners String?          @db.VarChar(255)
  extraRespondents String?          @db.VarChar(255)
  extraParties     String?          @db.VarChar(255)

  rawData    Json      @db.Json
  created_at DateTime  @default(now()) @db.Timestamp(6)
  updatedAt  DateTime? @default(dbgenerated("CURRENT_TIMESTAMP")) @db.Timestamptz(6)

  organizationId String       @db.Uuid
  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "eCourtCase_organization_organization_id_fk")

  Court Court @relation(fields: [courtId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "eCourtCase_courtId_court_id_fk")

  // to lookup case by case number of type OP/232/2021, we need to have a unique constraint on typeName, caseNo, caseRegYear per court per organization
  @@unique([organizationId, typeName, number, regYear, courtId], map: "case_organization_typeName_number_regYear_courtId_unique")
  @@unique([organizationId, crn], map: "case_organization_organization_id_fk")
  AdvocateCase AdvocateCase[] @relation(map: "advocateCase_caseId_case_id_fk")
}

model AdvocateCase {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId         String @db.Uuid
  advocateId     String @db.Uuid
  organizationId String @db.Uuid // Added this field to link with OrganizationMembers

  createdAt DateTime  @default(now()) @db.Timestamp(6)
  updatedAt DateTime? @db.Timestamptz(6)

  Case Case @relation(fields: [caseId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "advocateCase_caseId_case_id_fk")
  Advocate OrganizationMembers @relation(fields: [advocateId, organizationId], references: [userId, organizationId], onDelete: Cascade, onUpdate: NoAction, map: "advocateCase_advocateId_organizationId_fk")

  @@unique([caseId, advocateId], map: "advocateCase_caseId_advocateId_unique")
}

model State {
  stateCode String     @id @db.VarChar(2) // State code is unique to India
  name      String     @db.VarChar(255)
  District  District[]
}

model District {
  name         String         @db.VarChar(255)
  stateCode    String         @db.VarChar(2)
  districtCode String         @db.VarChar(2) // this districtCode is unique in state only, thus having a composite key with stateCode
  state        State          @relation(fields: [stateCode], references: [stateCode], onDelete: NoAction, onUpdate: NoAction, map: "district_state_stateCode_fk")
  CourtComplex CourtComplex[]
  Court        Court[]        @relation(map: "court_district_stateCode_districtCode_fk")

  @@id([stateCode, districtCode], map: "district_stateCode_districtCode_pk")
}

model CourtComplex {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String    @db.VarChar(255)
  stateCode    String
  districtCode String
  district     District  @relation(fields: [stateCode, districtCode], references: [stateCode, districtCode], onDelete: NoAction, onUpdate: NoAction, map: "courtComplex_stateCode_districtCode_fk")
  created_at   DateTime  @default(now()) @db.Timestamp(6)
  updatedAt    DateTime? @db.Timestamptz(6)

  Court          Court[]          @relation(map: "court_complexId_courtComplex_id_fk")
  CaseImportTask CaseImportTask[] @relation(map: "caseImportTask_courtComplexId_courtComplex_id_fk")
}

model Court {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courtCode    String       @db.VarChar(3) // court code is unique in a district
  name         String       @db.VarChar(255)
  complexId    String       @db.Uuid
  stateCode    String       @db.VarChar(2)
  districtCode String       @db.VarChar(2)
  district     District     @relation(fields: [stateCode, districtCode], references: [stateCode, districtCode], onDelete: NoAction, onUpdate: NoAction, map: "court_district_stateCode_districtCode_fk")
  complex      CourtComplex @relation(fields: [complexId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "court_complexId_courtComplex_id_fk")
  cases        Case[]       @relation(map: "Case_courtId_court_id_fk")

  @@unique([stateCode, districtCode, courtCode], map: "court_stateCode_districtCode_courtCode_unique")
}

enum CaseImportTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

model CaseImportTask {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String               @db.Uuid
  // courtComplexIds json is { complexes: string[] }
  courtComplexIds Json?
  advocateId      String               @db.Uuid
  caseStatus      String
  taskStatus      CaseImportTaskStatus @default(PENDING)
  taskMeta        Json?
  created_by      String               @db.Uuid
  created_at      DateTime             @default(now()) @db.Timestamp(6)
  updatedAt       DateTime?            @db.Timestamptz(6)
  advocate        OrganizationMembers  @relation(fields: [advocateId, organizationId], references: [userId, organizationId], onDelete: Cascade, onUpdate: NoAction, map: "caseImportTask_advocateId_organizationId_fk")
  user            User                 @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "caseImportTask_created_by_user_id_fk")
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "caseImportTask_organizationId_organization_id_fk")
  CourtComplex    CourtComplex?        @relation(fields: [courtComplexId], references: [id])
  courtComplexId  String?              @db.Uuid
}
