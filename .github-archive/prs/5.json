{"author":{"id":"MDQ6VXNlcjIwODQzMDkw","is_bot":false,"login":"vyshnavsdeepak","name":"Vyshnav S Deepak"},"baseRefName":"dev","body":"","comments":[{"id":"IC_kwDOMc4sOM6NXKe6","author":{"login":"linear"},"authorAssociation":"NONE","body":"<details>\n<summary><a href=\"https://linear.app/vyshnav2/issue/CB-3/show-case-history-on-click-of-case\">CB-3 show case history on click of case</a></summary>\n<p>\n\n```\nconst tableHTML = `<table border=\"0\" class='table tbl-result'>\n<thead><tr><th scope=\"col\" style=''>Judge</th><th scope=\"col\" style=''>Business on Date</th><th scope=\"col\" style=''>Hearing Date</th><th scope=\"col\" style=''>Purpose of Hearing</th></tr></thead>\n<tbody>\n<tr><td align='left' style=''>Judge, Family Court, Kannur</td><td align='left' style=''>23-09-2023</td><td>28-09-2023</td><td style=''> call on</td></tr>\n<!-- Repeat for all rows -->\n</tbody></table>`;\n\nfunction parseTableToJson(table) {\n  const rows = table.querySelectorAll('tbody tr');\n  const result = [];\n\n  rows.forEach(row => {\n    const cells = row.querySelectorAll('td');\n    const obj = {\n      judge: cells[0].innerText.trim(),\n      businessOnDate: cells[1].innerText.trim(),\n      hearingDate: cells[2].innerText.trim(),\n      purposeOfHearing: cells[3].innerText.trim(),\n    };\n    result.push(obj);\n  });\n\n  return result;\n}\n\nconst parser = new DOMParser();\nconst doc = parser.parseFromString(tableHTML, 'text/html');\nconst table = doc.querySelector('.tbl-result');\nconst jsonData = parseTableToJson(table);\n\nconsole.log(JSON.stringify(jsonData, null, 2));\n```\n\n```\n<table border=\\\"0\\\" class='table tbl-result'><thead><tr><th scope=\\\"col\\\" style=''>Judge</th><th scope=\\\"col\\\" style=''>Business on Date</th><th scope=\\\"col\\\" style=''>Hearing Date</th><th scope=\\\"col\\\" style=''>Purpose of Hearing</th></tr></thead><tbody><tr><td align='left' style=''>Judge, Family Court, Kannur</td><td align='left' style=''>23-09-2023</td><td>28-09-2023</td